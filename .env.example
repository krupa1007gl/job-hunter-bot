# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=
# Мастер-ключ шифрования AI-ключей пользователей.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеряешь — сохранённые ключи пользователей перестанут расшифровываться.
MASTER_KEY=
# Пароль Postgres (используется docker-compose)
POSTGRES_PASSWORD=

# Необязательно
# Закрытая бета: Telegram ID через запятую. Пусто — бот открыт всем.
ALLOWLIST=
# Токен приложения hh.ru (dev.hh.ru). Пусто — адаптер hh.ru выключен.
HH_TOKEN=
# Токен для /internal/stats. Пусто — эндпоинт выключен.
INTERNAL_TOKEN=
# Как часто собирать вакансии, минут
POLL_MINUTES=30
# Лимит LLM-вызовов на пользователя в сутки
LLM_DAILY_LIMIT=100
# User-Agent для запросов к источникам — укажи ссылку на свой репозиторий
USER_AGENT=job-hunter-bot/0.1 (+https://github.com/<you>/job-hunter-bot)
